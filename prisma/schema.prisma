enum FaqStatus {
  DRAFT
  PUBLISHED
}

// Fixed, singleton site sections a FAQ can be pinned to — distinct from the
// many-to-many entity relations below (Tour/Destination/Blog/Campaign/Activity),
// which cover "attached to one or more specific records" rather than "shown on
// one specific page." FAQ = also listed in the main /faq browse index — the
// single knowledge-base page where every published FAQ's full answer lives,
// expandable inline (no separate per-question page).
enum FaqPlacement {
  HOME
  ABOUT
  CONTACT
  FAQ
  REVIEWS
}

model FaqCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  faqs        Faq[]

  @@index([isActive, sortOrder])
}

// Single source of truth for all FAQ content sitewide. Placement on fixed
// sections is the `placements` array; placement on specific Tours/Destinations/
// Blogs/Campaigns/Activities is a real many-to-many relation — a FAQ exists
// exactly once and is referenced everywhere it's relevant, never duplicated.
model Faq {
  id             String         @id @default(cuid())
  question       String
  // Rendered on every page except this FAQ's own detail page — Homepage, Tour,
  // Destination, About, Contact all show only this, never `answer`, so their
  // FAQPage JSON-LD (built from the same data) never claims content that isn't
  // actually visible on that page.
  shortAnswer    String
  // Full explanation — rendered (and schema-marked) only on /faq/[slug].
  answer         String
  slug           String         @unique
  categoryId     String
  category       FaqCategory    @relation(fields: [categoryId], references: [id])
  status         FaqStatus      @default(DRAFT)
  featured       Boolean        @default(false)
  placements     FaqPlacement[]
  sortOrder      Int            @default(0)
  // Freshness/trust signal — several answers reference time-sensitive facts
  // (ticket booking rules, hospital names, road conditions). Optional; not
  // auto-updated by editing the answer, since a typo fix isn't a re-verification.
  lastReviewedAt DateTime?
  createdById    String?
  createdBy      User?          @relation("FaqCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById    String?
  updatedBy      User?          @relation("FaqUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tours        Tour[]
  destinations Destination[]
  blogs        Blog[]
  campaigns    Campaign[]
  activities   Activity[]

  @@index([status, categoryId, sortOrder])
}

