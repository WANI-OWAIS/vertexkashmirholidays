// ── Vertex Connect — Internal team communication ───────────────────────────────

enum RoomType {
  DIRECT
  GROUP
}

enum MemberRole {
  MEMBER
  ADMIN
}

enum PresenceStatus {
  ONLINE
  AWAY
  BUSY
  OFFLINE
}

enum MeetingStatus {
  SCHEDULED
  ACTIVE
  ENDED
}

enum MeetingType {
  AUDIO
  VIDEO
}

model ChatRoom {
  id          String        @id @default(cuid())
  type        RoomType
  name        String?
  avatarUrl   String?
  createdById String
  createdBy   User          @relation("ConnectRoomCreator", fields: [createdById], references: [id])
  members     ChatMember[]
  messages    ChatMessage[]
  meetings    Meeting[]
  archivedAt  DateTime?
  directKey   String?       @unique // "minUserId:maxUserId" for DIRECT rooms; null for GROUP
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([archivedAt])
  @@index([type])
  @@index([createdById])
}

model ChatMember {
  id         String     @id @default(cuid())
  roomId     String
  room       ChatRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation("ConnectMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role       MemberRole @default(MEMBER)
  lastReadAt DateTime?
  joinedAt   DateTime   @default(now())
  leftAt     DateTime?
  typingAt   DateTime?

  @@unique([roomId, userId])
  @@index([userId])
  @@index([roomId])
}

model ChatMessage {
  id                 String    @id @default(cuid())
  roomId             String
  room               ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId           String
  sender             User      @relation("ConnectMessageSender", fields: [senderId], references: [id])
  body               String?
  attachmentUrl      String?
  attachmentPublicId String?
  attachmentType     String?
  attachmentName     String?
  editedAt           DateTime?
  deletedAt          DateTime?
  reactions          String? // JSON: Record<emoji, userId[]>, one reaction per user
  isSystem           Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([roomId, createdAt])
  @@index([createdAt])
  @@index([senderId])
}

model UserPresence {
  userId     String         @id
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     PresenceStatus @default(OFFLINE)
  lastSeenAt DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model Meeting {
  id           String               @id @default(cuid())
  roomId       String?
  room         ChatRoom?            @relation(fields: [roomId], references: [id], onDelete: SetNull)
  title        String
  type         MeetingType          @default(AUDIO)
  jitsiRoomId  String               @unique
  createdById  String
  createdBy    User                 @relation("ConnectMeetingCreator", fields: [createdById], references: [id])
  endedAt      DateTime?
  status       MeetingStatus        @default(ACTIVE)
  participants MeetingParticipant[]
  createdAt    DateTime             @default(now())

  @@index([status])
  @@index([createdById])
  @@index([roomId])
  @@index([createdAt])
}

model MeetingParticipant {
  id        String    @id @default(cuid())
  meetingId String
  meeting   Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation("ConnectMeetingParticipants", fields: [userId], references: [id])
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  @@unique([meetingId, userId])
  @@index([userId])
}

// CMS-driven promotional banners. STRIP = thin full-width bar above the navbar
// (one visible at a time); PROMO = full-bleed background-image banner with
// overlaid text placed within page content areas. `pages` is a JSON string array
// of page keys ("home","tours",…) or ["*"] for all pages.
model Banner {
  id             String     @id @default(cuid())
  type           BannerType @default(STRIP)
  title          String
  body           String?
  ctaLabel       String?
  ctaUrl         String?
  imageUrl       String? // PROMO desktop background image
  imageMobileUrl String? // PROMO ≤640px background image (falls back to imageUrl)
  pages          String     @default("[\"*\"]") // JSON string array: ["home","tours"] or ["*"] for all
  isActive       Boolean    @default(true)
  sortOrder      Int        @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([type, isActive])
  @@index([sortOrder])
}

enum BannerType {
  STRIP // thin full-width bar above navbar — one visible at a time
  PROMO // rich image+text card placed within page content areas
}
