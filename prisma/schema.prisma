generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String               @id @default(cuid())
  name                 String?
  email                String               @unique
  phone                String?
  image                String? // profile picture URL (customer-managed in /account/profile)
  passwordHash         String
  role                 Role                 @default(CUSTOMER)
  // Set true for accounts created with a system-generated temp password (e.g. from
  // lead conversion). Forces a password change on first login before any other
  // account access is allowed. Cleared once the customer sets their own password.
  mustChangePassword   Boolean              @default(false)
  // Set on every successful sign-in (password, Google OAuth, Google One Tap —
  // see auth.ts). Null means this account has never logged in, which is what
  // both the "remind them to log in" targeting and the future never-logged-in
  // cleanup policy key off of.
  lastLoginAt          DateTime?
  // Sales incentive rate (percent) applied to a booking's PROFIT, not the booking
  // amount. Optional; only meaningful for SALES staff. Kept on the user so future
  // monthly salary/commission reports can compute payouts per salesperson.
  bookingConversionPct Float?
  // Employee profile fields (staff only; optional so nothing breaks for existing
  // rows). Source of truth for CURRENT employee info — payroll snapshots these
  // per month on SalaryRecord rather than reading them live.
  designation          String?
  employeeCode         String?              @unique
  monthlySalary        Float?
  joiningDate          DateTime?
  // `email`/`phone` above are treated as the employee's official/work contact
  // (email doubles as their login). These are their personal contact details.
  personalEmail        String?
  personalPhone        String?
  address              String?
  // TOTP MFA — mandatory for SUPERADMIN/ADMIN (see src/lib/rbac.ts requiresMfa).
  // mfaSecret is AES-256-GCM ciphertext (src/lib/security/mfaCrypto.ts), never
  // the plaintext base32 secret — verification needs it back, so it's encrypted
  // rather than hashed. mfaEnabledAt null = not yet enrolled/confirmed; a
  // freshly-(re)generated pending secret is stored here before confirmation too.
  mfaSecret            String?
  mfaEnabledAt         DateTime?
  recoveryCodes        MfaRecoveryCode[]
  deletedAt            DateTime? // soft-delete marker; non-null = hidden + login blocked
  // ── B2B Agent (Phase 1) ──────────────────────────────────────────────────
  // A B2B agent is a CUSTOMER-role User with agencyStatus set. Null = not a
  // B2B agent (every existing/normal User). PENDING = registered but not yet
  // reviewed (no B2B capability — every B2B route must gate on ACTIVE
  // server-side; login itself is never blocked by this field). ACTIVE = full
  // B2B capability. SUSPENDED = capability revoked without deleting the
  // account or its historical relationships (mirrors deletedAt's "hide, don't
  // delete" convention, but for capability rather than visibility/login).
  agencyStatus         B2BAgentStatus?
  agencyName               String?
  agencyWebsite            String?
  agencyRegistrationNumber String?
  agencyGstin              String?
  agencyState              String?
  agencyLogoUrl            String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  bookings             Booking[]
  commissions          BookingCommission[]
  salaryRecords        SalaryRecord[]       @relation("SalaryEmployee")
  salariesPaid         SalaryRecord[]       @relation("SalaryPaidBy")
  salariesCorrected    SalaryRecord[]       @relation("SalaryCorrectedBy")
  leaveRequests        LeaveRequest[]       @relation("LeaveEmployee")
  leaveReviews         LeaveRequest[]       @relation("LeaveReviewedBy")
  reviews              Review[]
  itineraries          Itinerary[]          @relation("ItineraryOwner")
  itinerariesEdited    Itinerary[]          @relation("ItineraryEditor")
  proposals            ProposalItinerary[]  @relation("ProposalOwner")
  leadsAssigned        Lead[]               @relation("LeadAssignee")
  b2bRequests          Lead[]               @relation("B2BAgentLeads")
  b2bRequestsCreated   Lead[]               @relation("LeadCreatedBy")
  notifications        Notification[]
  // ── Vertex Connect ────────────────────────────────────────────────────────
  chatRoomsCreated     ChatRoom[]           @relation("ConnectRoomCreator")
  chatMemberships      ChatMember[]         @relation("ConnectMemberships")
  chatMessagesSent     ChatMessage[]        @relation("ConnectMessageSender")
  presence             UserPresence?
  meetingsCreated      Meeting[]            @relation("ConnectMeetingCreator")
  meetingParticipants  MeetingParticipant[] @relation("ConnectMeetingParticipants")
  faqsCreated          Faq[]                @relation("FaqCreatedBy")
  faqsUpdated          Faq[]                @relation("FaqUpdatedBy")

  // email already has a unique index via @unique above — no separate @@index needed.
  @@index([deletedAt])
  @@index([role, deletedAt])
  @@index([agencyStatus])
}

// One-time recovery codes for staff TOTP MFA — issued once at enrollment
// confirmation, bcrypt-hashed like passwordHash/EmailOtp.codeHash. usedAt
// non-null means the code is burned and can never be reused.
model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// In-app notification for a staff user (e.g. a lead being assigned/reassigned).
// Best-effort, created alongside the equivalent email. `link` is an in-app path
// the bell dropdown deep-links to; `readAt` non-null = read.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // LEAD_ASSIGNED | LEAD_UNASSIGNED | …
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model Itinerary {
  id             String             @id @default(cuid())
  title          String
  status         ItineraryStatus    @default(DRAFT)
  data           Json
  ownerId        String
  owner          User               @relation("ItineraryOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  // Optional link to a CRM lead. @unique enforces a single current itinerary per
  // lead. Cascade so deleting a (non-converted) lead cleans up its itinerary.
  leadId         String?            @unique
  lead           Lead?              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // Optional link to a direct (website) booking — one current itinerary per
  // booking. Mutually exclusive with leadId in practice (a converted booking
  // uses its lead's itinerary). Cascade so deleting the booking cleans it up.
  bookingId      String?            @unique
  booking        Booking?           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  // Locked when the owning lead is converted — the final, immutable itinerary.
  locked         Boolean            @default(false)
  // Last editor (creator is `owner`). SetNull so a deleted staff user is tolerated.
  lastEditedById String?
  lastEditedBy   User?              @relation("ItineraryEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  history        ItineraryHistory[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  // ── Booking-token Razorpay Payment Link (see src/lib/itinerary/tokenPaymentLink.ts) ──
  // The single CURRENT active/most-recent fixed-amount (₹2,000, or the tour total
  // if lower) token Payment Link embedded as a QR in this itinerary's PDF. Kept on
  // Itinerary (not Booking) because a link can be minted while the itinerary is
  // still only Lead-linked, before conversion — Booking may not exist yet. Only
  // ever one row of "current" link state; a superseded (expired/replaced) link is
  // not retained locally — Razorpay's own dashboard/API is the audit trail.
  razorpayPaymentLinkId        String?   @unique
  razorpayPaymentLinkRefId     String?   @unique
  razorpayPaymentLinkUrl       String?
  // Paise, matching the gateway's own unit (see BookingPayment/create-order for
  // the same convention elsewhere in this codebase).
  razorpayPaymentLinkAmount    Int?
  // Incremented each time a NEW link is minted (not on reuse) — feeds the
  // reference_id suffix (…TOKEN-001, …TOKEN-002) so a regenerated-after-expiry
  // link never collides with a prior one.
  razorpayPaymentLinkSeq       Int       @default(0)
  razorpayPaymentLinkCreatedAt DateTime?

  @@index([ownerId])
  @@index([status])
  @@index([updatedAt])
  @@index([lastEditedById])
}

// Append-only audit trail: one snapshot row per saved version of an itinerary.
// Lets us see what was shared/updated over time. Cascade-deleted with its parent.
model ItineraryHistory {
  id           String    @id @default(cuid())
  itineraryId  String
  itinerary    Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  title        String
  data         Json
  editedById   String?
  editedByName String
  createdAt    DateTime  @default(now())

  @@index([itineraryId])
  @@index([createdAt])
}

// Standalone 3-tier (Budget/Premium/Luxury) proposal document — a generic,
// reusable comparison PDF generator, deliberately NOT linked to any Lead or
// Booking (unlike Itinerary). No lock/history/payment-link machinery here:
// there's no compliance surface for a document with no lead attached.
model ProposalItinerary {
  id        String         @id @default(cuid())
  title     String
  status    ProposalStatus @default(DRAFT)
  data      Json
  ownerId   String
  owner     User           @relation("ProposalOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([ownerId])
  @@index([status])
}

// Pending email-verification record for account registration, the
// forgot-password flow, Careers job-application email verification, AND public
// booking checkout (distinguished by `purpose`). A row is created when a
// visitor requests an OTP.
//
// REGISTER: the account is NOT created in `User` until the OTP is verified
// (passwordHash/name/phone hold the pending account's data).
//
// RESET: identity must be proven BEFORE a new password is ever collected, so
// this is a 3-step flow — request code -> verify code -> set new password.
// Verifying the code does not yet touch `User`; it stamps `verifiedAt` and
// issues a one-time `resetTokenHash` (bcrypt hash of a random token returned to
// the client once). The follow-up "set new password" call must present that
// token, proving it's the same browser session that completed the OTP step,
// before `User.passwordHash` is updated. The row is deleted once the password
// is actually changed (or expires).
//
// CAREERS: same "verified, proof token issued" shape as RESET — `verifiedAt` +
// `resetTokenHash` are stamped on successful verification, and the Careers
// application-submit endpoint must present that token as proof the same
// browser session completed the OTP step. Unlike REGISTER, this purpose must
// NEVER populate `name`/`passwordHash`/`phone` (or any other candidate field)
// on this row — the Careers module's entire premise is that no candidate PII
// is ever stored in the database; this table holds only the email being
// verified, never the application data attached to it.
//
// BOOKING: same "verified, proof token issued" shape as RESET/CAREERS. The
// booking create-order endpoint must present the token as proof the same
// browser session completed the OTP step. Not consumed at create-order time
// (an abandoned/retried checkout may call it more than once with the same
// token) — deleted once a payment actually succeeds (verify-payment/webhook).
//
// Expired rows (any purpose) are cleaned up on each request/verify call (see
// src/lib/auth/otp.ts -> cleanupExpiredOtps).
model EmailOtp {
  id             String     @id @default(cuid())
  email          String     @unique
  codeHash       String // bcrypt hash of the 6-digit OTP
  purpose        OtpPurpose @default(REGISTER)
  name           String? // pending account display name (REGISTER only)
  passwordHash   String? // pending account password, already bcrypt-hashed (REGISTER only)
  phone          String? // collected at sign-up; copied to User on verification (REGISTER only)
  attempts       Int        @default(0) // failed verification attempts
  expiresAt      DateTime // OTP code expiry
  lastSentAt     DateTime   @default(now()) // drives the 60s resend cooldown
  createdAt      DateTime   @default(now())
  verifiedAt     DateTime? // RESET/CAREERS only: set once the OTP code is verified
  resetTokenHash String? // RESET/CAREERS only: bcrypt hash of the one-time token issued after OTP verification

  // email already has a unique index via @unique above — no separate @@index needed.
  @@index([expiresAt])
}

enum OtpPurpose {
  REGISTER
  RESET
  CAREERS
  BOOKING
  B2B_REGISTER
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model RolePermission {
  id        String  @id @default(cuid())
  role      Role
  module    String
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)

  @@unique([role, module])
}

// Internal hotel supplier/rate reference for Sales quoting — deliberately NOT
// wired into Booking/Lead/Itinerary. Not a bookable-inventory master; a
// curated reference list Admin maintains. `data` holds the property contact
// info and the variable-shape rate list (room type × season × validity ×
// CP/MAP/AP + extra bed) as real Json, matching the Itinerary.data precedent
// — not the String-encoded-JSON convention used for Tour/Campaign fields.
// destination/category/isActive stay relational columns because they're the
// fields Sales actually filters/searches by; everything else nests in `data`.
model HotelSupplier {
  id                    String        @id @default(cuid())
  hotelName             String
  destination           String
  category              HotelCategory
  isActive              Boolean       @default(true)
  // Sales-curated "push this property first" flag — separate from `category`
  // (which is auto-derived from rate) since recommendation is a judgment call.
  recommended           Boolean       @default(false)
  // Manual tally of bookings sent to this hotel — staff-entered (not derived
  // from any Booking relation; HotelSupplier is a supplier reference, not
  // bookable inventory, per the module's own design — see schema.ts).
  bookingsCount         Int           @default(0)
  // Stamped by POST /api/hotel-suppliers/[id]/request-rates after a successful
  // send — never set any other way. Null means no request has been sent yet.
  lastRateRequestSentAt DateTime?
  data                  Json
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([destination])
  @@index([category])
  @@index([isActive])
  @@index([recommended])
}

enum HotelCategory {
  BUDGET
  DELUXE
  PREMIUM
  LUXURY
}

model Destination {
  id               String                @id @default(cuid())
  name             String
  slug             String                @unique
  description      String?
  excerpt          String?
  tagline          String?
  coverImage       String?
  coverImageMobile String?
  location         String?
  // Display facts shown on cards + detail page (free-form, admin-editable).
  altitude         String? // e.g. "2,650 m"
  season           String? // best season, e.g. "Apr – Oct"
  region           String? // filter grouping, e.g. "Kashmir Valley" | "Ladakh"
  // Coordinates power the live weather widget (Open-Meteo).
  latitude         Float?
  longitude        Float?
  isFeatured       Boolean               @default(false)
  sortOrder        Int                   @default(0)
  // string[] — short bullet reasons to visit.
  whyVisit         String                @default("[]")
  // { name: string; description: string }[]
  topAttractions   String                @default("[]")
  // Full seasonal writeup (HTML); `season` above stays as the short sidebar fact.
  bestTimeDetail   String?
  // HTML — air/road/rail directions.
  howToReach       String?
  // HTML — hotel/stay category guidance, same convention as Tour.accommodation.
  whereToStay      String?
  // { name: string; description: string }[]
  localFood        String                @default("[]")
  // { name: string; description: string }[]
  shopping         String                @default("[]")
  // string[] — numbered practical tips.
  travelTips       String                @default("[]")
  // Centralized FAQ module — replaces the legacy `faqs` JSON column (removed
  // in the Phase 6 cleanup once every page verified its cutover).
  relatedFaqs      Faq[]
  // Curated editorial links to Blog rows — string[] of Blog ids, no automatic matching.
  relatedBlogIds   String                @default("[]")
  // Independent OG/Twitter overrides — buildMetadata() already supports these params.
  ogTitle          String?
  ogDescription    String?
  metaTitle        String?
  metaDesc         String?
  ogImage          String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  tours            TourDestination[]
  activities       ActivityDestination[]

  // slug already has a unique index via @unique above — no separate @@index needed.
}

// Things to do — a first-class admin entity linked many-to-many to destinations
// and tours. Public listing/detail pages are planned but not built yet.
model Activity {
  id                 String                @id @default(cuid())
  name               String
  slug               String                @unique
  description        String?
  coverImage         String?
  coverImageMobile   String?
  images             String                @default("[]") // JSON string array of image URLs
  location           String?
  icon               String? // emoji or short icon label
  duration           String? // e.g. "2 hours", "Half day"
  price              Float?
  published          Boolean               @default(false)
  sortOrder          Int                   @default(0)
  // HTML — richer "Why Experience This" blurb; `description` above stays as the short Overview text.
  whyExperience      String?
  // { name: string; description: string }[]
  activityHighlights String                @default("[]")
  // HTML — season/time-of-day breakdown.
  bestTime           String?
  // Short label, e.g. "Very Easy", "Moderate".
  difficulty         String?
  // string[] — who this activity suits.
  suitableFor        String                @default("[]")
  // HTML — ticket/pricing policy, inclusions/exclusions.
  pricingGuide       String?
  // string[]
  safetyTips         String                @default("[]")
  // string[]
  whatToCarry        String                @default("[]")
  relatedFaqs        Faq[]
  metaTitle          String?
  metaDesc           String?
  ogImage            String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  destinations       ActivityDestination[]
  tours              ActivityTour[]

  // slug already has a unique index via @unique above — no separate @@index needed.
  @@index([published])
}

model ActivityDestination {
  activityId    String
  destinationId String
  activity      Activity    @relation(fields: [activityId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@id([activityId, destinationId])
  @@index([destinationId])
}

model ActivityTour {
  activityId String
  tourId     String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  tour       Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@id([activityId, tourId])
  @@index([tourId])
}

model Tour {
  id                 String            @id @default(cuid())
  title              String
  slug               String            @unique
  excerpt            String?
  description        String?
  category           TourCategory
  region             TourRegion        @default(KASHMIR)
  duration           Int
  coverImage         String?
  coverImageMobile   String?
  badge              String?
  badgeColor         String?           @default("green")
  gallery            String            @default("[]")
  itinerary          String            @default("[]")
  inclusions         String            @default("[]")
  exclusions         String            @default("[]")
  priceFrom          Float
  minPersons         Int               @default(1)
  priceWas           Float?
  discountPct        Int?
  bestseller         Boolean           @default(false)
  rating             Float             @default(0)
  reviewCount        Int               @default(0)
  published          Boolean           @default(false)
  // Which lead-capture forms render on the public tour-detail page.
  formMode           TourFormMode      @default(BOTH)
  metaTitle          String?
  metaDesc           String?
  ogImage            String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  bestTime           String?
  difficulty         String?
  relatedFaqs        Faq[]
  batches            String            @default("[]")
  happyCount         Int?
  highlights         String            @default("[]")
  pickupDrop         String?
  startCity          String?
  tagline            String?
  tourType           String?
  transport          String?
  // ── Extended content (Markdown-sourced tour detail sections) ──────────────
  perfectFor         String            @default("[]") // JSON string[]
  notIdealFor        String            @default("[]") // JSON string[]
  whyItineraryWorks  String? // HTML
  accommodation      String            @default("[]") // JSON AccommodationEntry[]
  accommodationImage String? // dedicated image for the Accommodation section, distinct from coverImage
  meals              String? // HTML
  transportDetail    String? // HTML — detailed policy paragraph, distinct from the short `transport` quick-fact
  budgetBreakdown    String            @default("[]") // JSON BudgetRow[]
  personalExpenses   String            @default("[]") // JSON PersonalExpenseRow[]
  bestTimeDetail     String? // HTML — detailed seasonal breakdown, distinct from the short `bestTime` quick-fact
  thingsToCarry      String            @default("[]") // JSON PackingItem[]
  localTravelTips    String            @default("[]") // JSON string[]
  importantNotes     String            @default("[]") // JSON ImportantNote[]
  whyVertexBlurb     String? // HTML
  ctaHeadline        String?
  ctaBody            String? // HTML
  ogTitle            String?
  ogDescription      String?
  relatedTours       String            @default("[]") // JSON RelatedTourEntry[], max 4
  bookings           Booking[]
  reviews            Review[]
  destinations       TourDestination[]
  activities         ActivityTour[]

  // slug already has a unique index via @unique above — no separate @@index needed.
  @@index([category])
  @@index([region])
  @@index([published])
  @@index([bestseller])
}

model TourDestination {
  id            String      @id @default(cuid())
  tourId        String
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  tour          Tour        @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, destinationId])
  @@index([tourId])
  @@index([destinationId])
}

model Booking {
  id                 String              @id @default(cuid())
  // Optional: lead-converted bookings have no tour and no Razorpay order.
  tourId             String?
  userId             String?
  status             BookingStatus       @default(PENDING)
  razorpayOrderId    String?             @unique
  razorpayPayId      String?
  // Canonical total booking amount (negotiated amount for leads; package price
  // for direct website bookings). Financials always derive from this + payments.
  amount             Float
  currency           String              @default("INR")
  // Customer's chosen online-payment option: "ADVANCE" (10% now) or "FULL".
  // Amounts are always derived server-side; this only records the choice.
  paymentOption      String?
  travelDate         DateTime
  travelEndDate      DateTime?
  travellers         Int                 @default(1)
  guestName          String
  guestEmail         String?
  guestPhone         String
  // Customer-supplied billing address + free-text custom requirements (direct
  // website bookings). Optional; lead-converted bookings leave these null.
  address            String?
  requirements       String?
  // Discount applied to the booking total. type: "FLAT" | "PERCENT".
  discountType       String?
  discountValue      Float               @default(0)
  // Free-form inclusion tags (e.g. Meals, Cab) stored as a JSON string array.
  inclusions         String              @default("[]")
  // Once locked, services can no longer be added/edited/deleted.
  servicesLocked     Boolean             @default(false)
  // Assigned driver/vehicle, added by staff after services are locked. Editable
  // only until one day before travelDate. driverAddedAt non-null = details exist.
  driverName         String?
  driverPhone        String?
  vehicleNumber      String?
  vehicleName        String?
  driverAddedAt      DateTime?
  // Soft-delete marker. Non-null = hidden from all listings/reports but the row
  // (and its payments/services) is retained. Permanent delete removes the row.
  deletedAt          DateTime?
  ipAddress          String?
  userAgent          String?
  // ── Marketing attribution — only ever set on DIRECT website bookings (no
  // Lead involved). Lead-converted bookings instead get these copied verbatim
  // from their originating Lead at conversion time (never captured twice).
  // Same shared field list/schema as Lead — see src/lib/attribution.ts.
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  utmTerm            String?
  utmContent         String?
  gclid              String?
  gbraid             String?
  wbraid             String?
  fbclid             String?
  msclkid            String?
  landingPage        String?
  referrer           String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tour               Tour?               @relation(fields: [tourId], references: [id])
  user               User?               @relation(fields: [userId], references: [id])
  leads              Lead[]
  payments           BookingPayment[]
  services           BookingService[]
  itinerary          Itinerary?
  offlineConversions OfflineConversion[]
  commission         BookingCommission?

  @@index([status])
  @@index([tourId])
  @@index([userId])
  @@index([createdAt])
  @@index([deletedAt, createdAt])
  @@index([guestEmail])
  @@index([status, createdAt])
}

// A single payment entry against a booking — the booking payment ledger.
// Supports token/advance, partial, and final payments (any number of rows).
model BookingPayment {
  id               String      @id @default(cuid())
  bookingId        String
  booking          Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount           Float
  type             PaymentType @default(PARTIAL)
  method           String? // cash / upi / card / razorpay / bank …
  reference        String? // gateway id, txn ref …
  // Razorpay record for online payments (null for staff-entered cash/UPI etc.).
  // `reference` holds the payment id; these hold the rest of the gateway record.
  gatewayOrderId   String?
  gatewaySignature String?
  metadata         String? // JSON blob of gateway metadata (method, bank, etc.)
  note             String?
  // GST applies only to non-cash payments and is optional. Both the selected
  // percent and the computed value are persisted so future booking-wise and
  // payment-wise GST reports need no recomputation. Null for cash / no GST.
  gstPercent       Float?
  gstAmount        Float?
  recordedById     String?
  createdAt        DateTime    @default(now())

  @@index([bookingId])
  @@index([createdAt])
}

// A line item in a booking's services sheet. One table covers all kinds; only
// the columns relevant to a kind are populated (others stay null).
model BookingService {
  id        String      @id @default(cuid())
  bookingId String
  booking   Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  kind      ServiceKind
  name      String // Hotel name / Cab name / Activity name / Other name
  amount    Float       @default(0)
  location  String? // hotel + activity
  nights    Int? // hotel
  roomType  String? // hotel — e.g. "1 room", "1 room + 1 extra bed", "Family room"
  pickup    String? // transport
  dropoff   String? // transport
  timing    String? // activity
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())

  @@index([bookingId])
}

// One row per lead-converted booking, tracking the salesperson's commission
// through its lifecycle. Direct/website bookings (no linked Lead) never get a
// row — there's no salesperson to credit. rateSnapshotPct is frozen from the
// employee's User.bookingConversionPct at creation time (lead-conversion) so a
// later change to the employee's rate never rewrites historical commissions.
// profitAmount/commissionAmount stay live-recomputed while EXPECTED (service
// costs usually aren't known yet at conversion time) and freeze once EARNED.
model BookingCommission {
  id               String           @id @default(cuid())
  bookingId        String           @unique
  booking          Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         User             @relation(fields: [employeeId], references: [id])
  rateSnapshotPct  Float
  profitAmount     Float            @default(0)
  commissionAmount Float            @default(0)
  status           CommissionStatus @default(EXPECTED)
  earnedAt         DateTime?
  paidAt           DateTime?
  paidReference    String?
  // Set when a payroll run "claims" this row for a specific month's salary —
  // prevents the same earned commission being counted in two different months'
  // payroll, and tells the PAID transition exactly which rows to flip to PAID.
  salaryRecordId   String?
  salaryRecord     SalaryRecord?    @relation(fields: [salaryRecordId], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([salaryRecordId])
  @@index([employeeId, status, earnedAt])
}

// One payroll record per employee per calendar month (salaryMonth = "2026-08",
// never a timestamp — avoids month-boundary/timezone bugs). Values are
// snapshotted at prepare time — an employee's monthlySalary/commission changing
// later never rewrites an already-prepared record. commission comes from the
// BookingCommission rows it has claimed (see BookingCommission.salaryRecordId);
// commissionAdjustment is a separate, clearly-labelled manual correction field —
// Finance never edits BookingCommission rows directly.
model SalaryRecord {
  id                   String              @id @default(cuid())
  employeeId           String
  employee             User                @relation("SalaryEmployee", fields: [employeeId], references: [id])
  salaryMonth          String // "YYYY-MM"
  monthlySalary        Float // snapshot of User.monthlySalary at prepare time
  commission           Float               @default(0) // sum of claimed BookingCommission.commissionAmount
  commissionAdjustment Float               @default(0) // manual correction, never overwrites BookingCommission
  paidDays             Float               @default(0)
  absentDays           Float               @default(0)
  paidLeaveDays        Float               @default(0)
  unpaidLeaveDays      Float               @default(0)
  deductions           Float               @default(0)
  netSalary            Float // monthlySalary + commission + commissionAdjustment - deductions, stored at save time
  status               SalaryStatus        @default(DRAFT)
  employeeReviewedAt   DateTime? // "Looks Good" acknowledgement — not a payment approval
  paidAt               DateTime?
  paidById             String?
  paidBy               User?               @relation("SalaryPaidBy", fields: [paidById], references: [id])
  paymentReference     String?
  // Set only when a PAID record is corrected — full before/after detail lives in
  // AuditLog (SALARY_CORRECTED); these are just cheap fields for an at-a-glance
  // "this was corrected" badge in the UI.
  correctedAt          DateTime?
  correctedById        String?
  correctedBy          User?               @relation("SalaryCorrectedBy", fields: [correctedById], references: [id])
  correctionReason     String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  claimedCommissions   BookingCommission[]

  @@unique([employeeId, salaryMonth])
  @@index([salaryMonth])
  @@index([status])
}

// Simple employee leave tracking. No stored balance — entitlement (1.5 paid
// days/month, no carry-forward) is computed on read from APPROVED requests.
model LeaveRequest {
  id           String      @id @default(cuid())
  employeeId   String
  employee     User        @relation("LeaveEmployee", fields: [employeeId], references: [id])
  type         LeaveType
  startDate    DateTime
  endDate      DateTime
  days         Float // supports half-day (0.5) granularity
  reason       String?
  status       LeaveStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?       @relation("LeaveReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([employeeId])
  @@index([status])
}

// Append-only payment audit trail. Records every payment-gateway event (order
// creation, signature verification success/failure, webhook events) for security
// review + dispute resolution. bookingId is a loose reference (no FK) so the
// audit survives a booking deletion. Never throws — best-effort writes.
model PaymentAudit {
  id        String   @id @default(cuid())
  bookingId String?
  event     String // ORDER_CREATED | PAYMENT_VERIFIED | VERIFICATION_FAILED | WEBHOOK_CAPTURED | WEBHOOK_FAILED
  status    String? // success | failed
  orderId   String?
  paymentId String?
  amount    Float?
  ip        String?
  detail    String? // free text / JSON context (never raw secrets)
  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([event])
  @@index([createdAt])
}

model Lead {
  id                 String              @id @default(cuid())
  name               String
  phone              String
  email              String?
  source             LeadSource          @default(WEBSITE)
  // Free-text page/campaign tag (home, tours, blog-detail, …). The LeadSource
  // enum captures the marketing channel; this captures which on-site form fired.
  sourcePage         String?
  category           LeadCategory?
  adults             Int                 @default(1)
  children           Int?
  startDate          DateTime?
  endDate            DateTime?
  attachments        String              @default("[]")
  notes              String?
  followUpAt         DateTime?
  assignedToId       String?
  assignedTo         User?               @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  // ── B2B request (Phase 2) ────────────────────────────────────────────────
  // Non-null b2bAgentId is the ONLY discriminator for "this Lead is a B2B
  // request" — no separate leadType field (mirrors the Itinerary.leadId/
  // bookingId nullable-FK-as-discriminator idiom already used elsewhere in
  // this schema). Restrict (not Cascade/SetNull): a B2B agent must never be
  // hard-deletable while historical requests exist.
  b2bAgentId         String?
  b2bAgent           User?               @relation("B2BAgentLeads", fields: [b2bAgentId], references: [id], onDelete: Restrict)
  // Who created this request: null = the agent self-submitted; set = a staff
  // member created it on the agent's behalf (mirrors assignedToId's shape).
  // Normal (non-B2B) leads never set this.
  createdById        String?
  createdBy          User?               @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  // B2B-request-only fields — always null on normal leads.
  days               Int?
  rooms              Int?
  budget             Float?
  status             LeadStatus          @default(NEW)
  bookingId          String?
  booking            Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  negotiatedAmount   Float?
  tokenAmount        Float?
  // Set true on conversion; blocks lead/itinerary edits until an admin unlocks.
  locked             Boolean             @default(false)
  ipAddress          String?
  userAgent          String?
  // ── Marketing attribution — captured once at submission, permanent from then
  // on. See src/lib/attribution.ts (single shared field list/schema). Copied
  // verbatim onto Booking at conversion time (src/app/api/leads/[id]/convert) —
  // never re-derived or duplicated as separate logic.
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  utmTerm            String?
  utmContent         String?
  gclid              String?
  gbraid             String?
  wbraid             String?
  fbclid             String?
  msclkid            String?
  landingPage        String?
  referrer           String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  activities         LeadActivity[]
  itinerary          Itinerary?
  offlineConversions OfflineConversion[]

  @@index([status])
  @@index([source])
  @@index([category])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([followUpAt])
  @@index([assignedToId, createdAt])
  @@index([status, createdAt])
  // Public-form dedupe looks up the most recent lead by normalized phone/email.
  @@index([phone])
  @@index([email])
  // Booking.leads relation lookups (admin booking detail pages).
  @@index([bookingId])
  // Agent's-own-requests + CRM B2B-requests-listing queries.
  @@index([b2bAgentId])
}

// Bridges attribution across the WhatsApp gap: a visitor's captured attribution
// (see src/lib/attribution.ts — ATTRIBUTION_FIELDS is the single source of
// truth this model mirrors) is minted into a short-lived token embedded in the
// WhatsApp prefilled message, then resolved back into a Lead's attribution
// fields when a salesperson manually creates the CRM Lead from that chat.
// Deliberately standalone — no relation to Lead, since the Lead doesn't exist
// yet when the token is minted.
model WhatsAppAttributionToken {
  id          String    @id @default(cuid())
  token       String    @unique
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  gclid       String?
  gbraid      String?
  wbraid      String?
  fbclid      String?
  msclkid     String?
  landingPage String?
  referrer    String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?

  // token already has a unique index via @unique above.
  @@index([expiresAt])
}

enum OfflineConversionPlatform {
  GOOGLE
  META
  MICROSOFT
}

enum OfflineConversionStatus {
  PENDING
  SENT
  FAILED
}

// Sync-only queue for uploading a Lead/Booking conversion to an ad platform's
// offline-conversion API. Deliberately does NOT duplicate Lead/Booking data —
// attribution is read live from the linked record at upload time (see
// src/lib/offlineConversion/service.ts). Exactly one of leadId/bookingId is
// set per row, mirroring the existing Itinerary.leadId/bookingId pattern.
model OfflineConversion {
  id               String                    @id @default(cuid())
  leadId           String?
  lead             Lead?                     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  bookingId        String?
  booking          Booking?                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  platform         OfflineConversionPlatform
  status           OfflineConversionStatus   @default(PENDING)
  attempts         Int                       @default(0)
  lastError        String?
  // Raw platform API response, stored as a JSON string (same convention as
  // every other JSON column in this schema — see .claude/rules/prisma-db.md).
  platformResponse String?
  sentAt           DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  // Postgres treats NULLs as distinct, so each unique constraint only bites on
  // the journey it applies to — a Lead-sourced row and a Booking-sourced row
  // never collide with each other.
  @@unique([leadId, platform])
  @@unique([bookingId, platform])
  @@index([status])
}

model LeadActivity {
  id              String           @id @default(cuid())
  leadId          String
  lead            Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type            LeadActivityType
