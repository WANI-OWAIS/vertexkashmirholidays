model SiteSettings {
  id                           String   @id @default("singleton")
  siteName                     String   @default("Vertex Kashmir Holidays")
  siteTagline                  String?
  siteEmail                    String?
  sitePhone                    String?
  siteAddress                  String?
  whatsapp                     String?
  facebook                     String?
  instagram                    String?
  twitter                      String?
  youtube                      String?
  googleReviews                String?
  tripadvisor                  String?
  // Canonical Google Business Profile / Maps listing URL — a stronger
  // same-entity signal than the googleReviews share-link above, included in
  // the TravelAgency schema's sameAs array (src/app/(public)/layout.tsx).
  googleBusinessProfile        String?
  // Live review integrations for the /reviews page — googlePlaceId feeds the
  // Places API lookup (src/lib/reviews/googlePlaces.ts). The two TripAdvisor
  // fields hold raw embed snippets pasted from TripAdvisor's own widget
  // generator (parsed at render time — see src/lib/reviews/tripadvisorWidget.ts),
  // one per placement since each uses a different widget type/size.
  googlePlaceId                String?
  tripadvisorHeroWidgetEmbed   String?
  tripadvisorRatingWidgetEmbed String?
  metaTitle                    String?
  metaDesc                     String?
  ogImage                      String?
  // Configurable GST percentage options offered when recording non-cash payments,
  // stored as a JSON number array so they can change without a schema migration.
  gstRates                     String   @default("[5,16,18]")
  showAnnouncementBanner       Boolean  @default(false)
  announcementMessage          String?
  // Legal/business identity — distinct from the brand-level siteName/siteAddress
  // above. Used in JSON-LD, legal pages, and generated PDFs/itineraries so those
  // don't each hardcode their own (previously drifting) copy.
  legalName                    String?
  tourismRegNumber             String?
  // Issuing authority for tourismRegNumber (e.g. "Department of Tourism,
  // Government of Jammu & Kashmir") — admin-entered rather than assumed, since
  // only the business owner can confirm the exact official wording. Shown on
  // About's Licenses & Certifications section only when populated.
  tourismRegAuthority          String?
  // GSTIN (India GST registration number) — distinct from tourismRegNumber
  // (that's a J&K Tourism license, not a tax ID). Shown near the footer logo
  // alongside the tourism registration, and used as JSON-LD taxId.
  gstNumber                    String?
  addressLine1                 String?
  addressCity                  String?
  addressState                 String?
  addressPincode               String?
  addressCountry               String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

